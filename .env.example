# These values are produced by `azd provision` and written to `.azure/<env>/.env`.
# `src/config.py` reads that file automatically, so copying this template is only
# necessary when running against an environment you did not provision locally.
#
# Never commit a populated .env file.

AZURE_AI_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/muni-deal-desk"
AZURE_AI_ACCOUNT_ENDPOINT="https://<account>.cognitiveservices.azure.com/"

AZURE_AI_EXTRACTION_DEPLOYMENT="gpt-5.4-mini"
AZURE_AI_REASONING_DEPLOYMENT="gpt-5.5"
AZURE_AI_ROUTER_DEPLOYMENT="model-router"
AZURE_AI_EMBEDDING_DEPLOYMENT="text-embedding-3-large"

AZURE_SEARCH_ENDPOINT="https://<search>.search.windows.net"
AZURE_SEARCH_CONNECTION_NAME="<search>"

AZURE_STORAGE_ACCOUNT_NAME="<storage>"
AZURE_STORAGE_BLOB_ENDPOINT="https://<storage>.blob.core.windows.net/"
AZURE_STORAGE_CORPUS_CONTAINER="corpus"

APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=..."
